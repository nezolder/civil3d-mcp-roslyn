<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Civil3DReferencesPath Condition="'$(Civil3DReferencesPath)' == ''">..\..\C_References</Civil3DReferencesPath>
  </PropertyGroup>

  <!-- Roslyn scripting for code execution -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
  </ItemGroup>

  <!-- Civil 3D / AutoCAD references -->
  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(Civil3DReferencesPath)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Acdbmgd">
      <HintPath>$(Civil3DReferencesPath)\AcDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Acmgd">
      <HintPath>$(Civil3DReferencesPath)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>$(Civil3DReferencesPath)\AecBaseMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>$(Civil3DReferencesPath)\AeccDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!--
    Stamps the source commit and the build time into the assembly, so that a
    running plugin can say which state it was built from (see BuildInfo.cs).
    Without git the commit is "unknown". A build from a folder that git refuses
    to read can pass the value in: dotnet build -p:Civil3dMcpCommit=<full hash>
  -->
  <Target Name="Civil3dMcpBuildStamp" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_Civil3dMcpStampFile>$(IntermediateOutputPath)Civil3dMcpBuildStamp.g.cs</_Civil3dMcpStampFile>
    </PropertyGroup>
    <Exec
      Condition="'$(Civil3dMcpCommit)' == ''"
      Command="git rev-parse HEAD"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      ConsoleToMSBuild="true"
      IgnoreExitCode="true"
      ContinueOnError="true"
      EchoOff="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_Civil3dMcpGitHead" />
      <Output TaskParameter="ExitCode" PropertyName="_Civil3dMcpGitHeadExit" />
    </Exec>
    <Exec
      Condition="'$(Civil3dMcpCommit)' == '' And '$(_Civil3dMcpGitHeadExit)' == '0'"
      Command="git status --porcelain --untracked-files=no"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      ConsoleToMSBuild="true"
      IgnoreExitCode="true"
      ContinueOnError="true"
      EchoOff="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_Civil3dMcpGitStatus" />
      <Output TaskParameter="ExitCode" PropertyName="_Civil3dMcpGitStatusExit" />
    </Exec>
    <PropertyGroup>
      <_Civil3dMcpGitHeadValid>false</_Civil3dMcpGitHeadValid>
      <_Civil3dMcpGitHeadValid Condition="'$(_Civil3dMcpGitHeadExit)' == '0'">$([System.Text.RegularExpressions.Regex]::IsMatch('$(_Civil3dMcpGitHead)', '^[0-9a-f]{40}$'))</_Civil3dMcpGitHeadValid>
      <Civil3dMcpDirty Condition="'$(Civil3dMcpDirty)' == '' And '$(Civil3dMcpCommit)' == '' And '$(_Civil3dMcpGitHeadValid)' == 'true' And '$(_Civil3dMcpGitStatusExit)' == '0' And '$(_Civil3dMcpGitStatus)' == ''">false</Civil3dMcpDirty>
      <Civil3dMcpDirty Condition="'$(Civil3dMcpDirty)' == '' And '$(Civil3dMcpCommit)' == '' And '$(_Civil3dMcpGitHeadValid)' == 'true' And '$(_Civil3dMcpGitStatusExit)' == '0'">true</Civil3dMcpDirty>
      <Civil3dMcpDirty Condition="'$(Civil3dMcpDirty)' == ''">unknown</Civil3dMcpDirty>
      <Civil3dMcpCommit Condition="'$(Civil3dMcpCommit)' == '' And '$(_Civil3dMcpGitHeadValid)' == 'true'">$(_Civil3dMcpGitHead)</Civil3dMcpCommit>
      <Civil3dMcpCommit Condition="'$(Civil3dMcpCommit)' == ''">unknown</Civil3dMcpCommit>
      <_Civil3dMcpBuiltAtUtc>$([System.DateTime]::UtcNow.ToString('o'))</_Civil3dMcpBuiltAtUtc>
    </PropertyGroup>
    <ItemGroup>
      <_Civil3dMcpStampLine Include="// Generated by the Civil3dMcpBuildStamp target. Do not edit." />
      <_Civil3dMcpStampLine Include="[assembly: System.Reflection.AssemblyMetadata(&quot;Civil3dMcpCommit&quot;, &quot;$(Civil3dMcpCommit)&quot;)]" />
      <_Civil3dMcpStampLine Include="[assembly: System.Reflection.AssemblyMetadata(&quot;Civil3dMcpDirty&quot;, &quot;$(Civil3dMcpDirty)&quot;)]" />
      <_Civil3dMcpStampLine Include="[assembly: System.Reflection.AssemblyMetadata(&quot;Civil3dMcpBuiltAtUtc&quot;, &quot;$(_Civil3dMcpBuiltAtUtc)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(_Civil3dMcpStampFile)" Lines="@(_Civil3dMcpStampLine)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(_Civil3dMcpStampFile)" />
      <FileWrites Include="$(_Civil3dMcpStampFile)" />
    </ItemGroup>
  </Target>
</Project>
